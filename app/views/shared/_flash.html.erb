<% flash.each do |type, message| %>
  <% if message.is_a?(String) && message.present? %>
    <div class="alert rounded-xl p-2 shadow-lg break-normal font-medium <%= flash_style(type) %>"
         role="<%= flash_role(type) %>"
         data-controller="flash"
         data-flash-auto-dismiss-value="<%= type.to_s.in?(%w[alert error]) ? 0 : 4000 %>"
         data-turbo-temporary="true">
      <span><%= message %></span>
      <button type="button"
              class="btn btn-ghost btn-xs btn-square"
              data-action="flash#dismiss"
              aria-label="<%= t("shared.flash.dismiss") %>">
        <%= icon_tag "x-mark", class: "size-4" %>
      </button>
    </div>
  <% end %>
<% end %>
