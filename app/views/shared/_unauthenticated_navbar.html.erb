<nav class="flex justify-between px-6 py-2 bg-base-100" aria-label="<%= t("shared.navigation.home") %>">
  <%# left %>
  <div class="flex items-center gap-2">
    <div>
      <%= link_to Rails.application.config_for(:settings).dig(:site, :website_url), class: "no-underline" do %>
        <%= image_tag "svg/logo.svg", alt: Rails.application.config_for(:settings).dig(:site, :name), class: "size-8 lg:hidden" %>
        <%= image_tag "svg/logo-wordmark.svg", alt: Rails.application.config_for(:settings).dig(:site, :name), class: "w-auto h-8 hidden lg:block" %>
      <% end %>
    </div>
  </div>

  <%# right %>
  <div class="menu menu-horizontal gap-2">
    <%= nav_link t("shared.navigation.login"), new_session_path, class_inactive: "bg-base-200" %>
  </div>
</nav>
