<% content_for :title, t("users.invitations.show.title") %>

<div class="flex flex-col items-center gap-6">
  <p class="text-base-content/60"><%= t("users.invitations.show.subtitle") %></p>
  <%= organization_avatar(@organization, classes: "size-20") %>
  <h1 class="text-2xl font-bold"><%= @organization.name %></h1>
  <span class="badge badge-soft"><%= @invitation.role.humanize %></span>
  <div class="flex flex-col gap-2 w-full">
    <%= button_to t("users.invitations.show.accept"), accept_user_invitation_path(@invitation), method: :patch, class: "btn btn-primary btn-block" %>
    <%= button_to t("users.invitations.show.decline"), decline_user_invitation_path(@invitation), method: :patch, class: "btn btn-error btn-outline btn-block" %>
  </div>
</div>
