<% content_for :title, t("users.edit.title") %>

<%= modal title: t("users.edit.title"), size: :narrow, close_on_submit: false do %>
  <%= simple_form_for @user, url: user_path, method: :patch, html: { class: "space-y-4" } do |f| %>
    <%= render "shared/errors", object: @user %>

    <%= f.input :avatar,
                as: :dropzone,
                input_html: { accept: "image/png, image/jpeg, image/gif" } %>
    <% if @user.avatar.attached? %>
      <div class="flex items-center justify-between gap-3">
        <%= user_avatar(@user, classes: "size-12") %>
        <%= link_to t("users.edit.remove_avatar"), user_avatar_path, data: { turbo_method: :delete, turbo_confirm: t("users.edit.remove_avatar_confirm") }, class: "btn btn-soft btn-sm text-error" %>
      </div>
    <% end %>

    <%= f.input :name,
                input_html: {
                  value: @user.name,
                  autocomplete: "name"
                } %>

    <%= f.input :marketing_consent, as: :boolean %>

    <div class="flex justify-end"><%= f.button :submit, t("shared.actions.save_changes"), class: "btn btn-primary" %></div>
  <% end %>

  <div class="divider"></div>
  <%= link_to t("users.email_changes.new.title"), new_user_email_change_path, class: "btn btn-soft w-full", data: { turbo_frame: "_top" } %>
<% end %>
