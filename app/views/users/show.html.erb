<% content_for :title, @user.name %>

<%= render SectionComponent.new(full_width: false) do %>
  <%= render "shared/user_info", user: @user %>

  <div class="menu menu-xl w-full"><%= render "shared/user_links", user: @user %></div>

  <%= render "shared/danger_zone" do %>
    <% reasons = @user.undeletable_reasons %>
    <% if reasons.any? %>
      <li><span class="text-base-content/60 cursor-not-allowed justify-center" title="<%= blocking_reasons_sentence(reasons, scope: 'users.security.delete_account_disabled') %>"><%= t("users.security.delete_account") %></span></li>
    <% else %>
      <li><%= link_to t("users.security.delete_account"), user_path, data: { turbo_method: :delete, turbo_confirm: t("users.security.delete_account_confirm") }, class: "text-error justify-center" %></li>
    <% end %>
  <% end %>
<% end %>
