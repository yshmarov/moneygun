<%= render SectionComponent.new(title: t(".title"), subtitle: t(".subtitle")) do |component| %>
  <div
    data-controller="clipboard"
    data-clipboard-success-content-value="<%= t("shared.actions.copied") %>"
    class="flex items-center gap-2"
  >
    <label class="floating-label w-full">
      <%= text_field_tag nil, root_url(Refer.param_name => @referral_code.code), readonly: true, data: { clipboard_target: "source" }, class: "input w-full", placeholder: " " %>
      <span><%= t(".referral_link_label") %></span>
    </label>

    <button
      type="button"
      data-action="clipboard#copy"
      data-clipboard-target="button"
      class="btn btn-neutral"
    >
      <%= t("shared.actions.copy") %>
    </button>
  </div>

  <br>

  <div class="stats stats-vertical md:stats-horizontal bg-base-200 w-full">
    <div class="stat">
      <div class="stat-title"><%= t(".clicks") %></div>
      <div class="stat-value"><%= number_with_delimiter(@referral_code.visits_count) %></div>
      <div class="stat-desc"><%= t(".clicks_description") %></div>
    </div>

    <div class="stat">
      <div class="stat-title"><%= t(".referrals") %></div>
      <div class="stat-value"><%= number_with_delimiter(@referral_code.referrals.count) %></div>
      <div class="stat-desc"><%= t(".referrals_description") %></div>
    </div>

    <div class="stat">
      <div class="stat-title"><%= t(".completed") %></div>
      <div class="stat-value"><%= number_with_delimiter(@referral_code.referrals.completed.count) %></div>
      <div class="stat-desc"><%= t(".completed_description") %></div>
    </div>
  </div>
<% end %>

<br>

<%= render SectionComponent.new(title: t(".table.referrals_list")) do %>
  <% if @referrals.any? %>
    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th><%= t(".table.referee") %></th>
            <th><%= t(".table.referred_at") %></th>
            <th><%= t(".table.status") %></th>
            <th><%= t(".table.completed_at") %></th>
          </tr>
        </thead>

        <tbody>
          <% @referrals.each do |referral| %>
            <tr>
              <td data-label="<%= t(".table.referee") %>">
                <div class="flex items-center gap-2">
                  <%= user_avatar(referral.referee) %>
                  <span class="font-medium"><%= referral.referee.email %></span>
                </div>
              </td>

              <td data-label="<%= t(".table.referred_at") %>">
                <%= local_time_tag(referral.created_at, format: :long) %>
              </td>

              <td data-label="<%= t(".table.status") %>">
                <% if referral.completed_at.present? %>
                  <span class="badge badge-success">
                    <%= t(".table.status_completed") %>
                  </span>
                <% else %>
                  <span class="badge badge-warning">
                    <%= t(".table.status_pending") %>
                  </span>
                <% end %>
              </td>

              <td data-label="<%= t(".table.completed_at") %>">
                <% if referral.completed_at %>
                  <%= local_time_tag(referral.completed_at, format: :short) %>
                <% else %>
                  <span class="text-gray-400">-</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div
      class="
        text-center py-16 text-base-content/50 bg-base-200 rounded-2xl
        border border-base-content/2
      "
    >
      <%= t(".table.no_referrals") %>
    </div>
  <% end %>
<% end %>
