<% tabs = [
     {
       key: :memberships,
       path: organization_memberships_path(@organization),
       icon: "🤝",
       label: t("organizations.memberships.index.title")
     },
     {
       key: :invitations,
       path: organization_invitations_path(@organization),
       label: t("organizations.invitations.index.title"),
       badge_count: @organization.invitations.pending.count,
       condition: policy(Membership).create?
     },
     {
       key: :requests,
       path: organization_received_join_requests_path(@organization),
       label: t("join_requests.index.title"),
       badge_count: @organization.received_join_requests.pending.count,
       condition: policy(Membership).create? && @organization.privacy_setting_restricted?
     }
   ] %>

<%= render SectionComponent.new(title: t("organizations.memberships.index.title")) do |component| %>
  <% component.with_action_list do %>
    <%= link_to t("organizations.invitations.new.title"), new_organization_invitation_path(@organization), data: { turbo_frame: :modal }, class: "btn btn-primary" if policy(Invitation).create? %>
  <% end %>

  <nav class="tabs tabs-border w-full overflow-x-auto" aria-label="<%= t("organizations.memberships.index.title") %>">
    <% tabs.each do |tab| %>
      <% next if tab[:condition] == false %>
      <%= link_to tab[:path], class: "tab #{'tab-active' if active_tab == tab[:key]}", aria: { current: ("page" if active_tab == tab[:key]) } do %>
        <%= tab[:label] %>
        <% if tab[:badge_count].to_i.positive? %>
          <span class="badge badge-sm badge-warning ml-1"><%= tab[:badge_count] %></span>
        <% end %>
      <% end %>
    <% end %>
  </nav>
  <br>
<% end %>
