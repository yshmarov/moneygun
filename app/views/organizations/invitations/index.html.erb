<% content_for :title, t("organizations.invitations.index.title") %>

<%= render "organizations/memberships/tabs", active_tab: :invitations %>

<%= render SectionComponent.new do %>
  <div class="table-responsive" data-table-collection>
    <table>
      <thead>
        <tr>
          <th><%= Invitation.human_attribute_name(:email) %></th>
          <th><%= Invitation.human_attribute_name(:role) %></th>
          <th><%= Invitation.human_attribute_name(:expires_at) %></th>
          <th></th>
        </tr>
      </thead>
      <tbody id="invitations">
        <% @invitations.each do |invitation| %>
          <tr>
            <td><%= invitation.email %></td>
            <td><span class="badge badge-soft"><%= invitation.role %></span></td>
            <td><%= local_time_tag invitation.expires_at, format: :short_time %></td>
            <td>
              <div class="flex justify-end gap-2">
                <%= button_to t("organizations.invitations.index.resend"), resend_organization_invitation_path(@organization, invitation), class: "btn btn-ghost btn-sm" %>
                <%= button_to t("organizations.invitations.index.revoke"), organization_invitation_path(@organization, invitation), method: :delete, class: "btn btn-error btn-outline btn-sm" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div data-blank-slate><%= render EmptyStateComponent.new(title: t("organizations.invitations.index.empty"), icon: "📩") %></div>
<% end %>
