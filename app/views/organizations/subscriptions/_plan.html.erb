<% if Current.organization.complimentary_access? %>
  <% monthly_plan = plans.find { |plan| plan[:interval].to_s == "month" } %>

  <%= render SectionComponent.new(full_width: false) do |component| %>
    <% component.with_page_title t(".title"), back_to: organization_path(Current.organization) %>

    <div class="rounded-box bg-base-200 p-6 space-y-4">
      <div class="flex items-center gap-2">
        <span class="font-semibold"><%= t(".granted_access") %></span>
        <%= subscription_status_label(Current.organization) %>
      </div>

      <p class="text-base-content/70 text-sm"><%= subscription ? t(".granted_access_after_cancellation", site_name: Rails.application.config_for(:settings).dig(:site, :name)) : t(".granted_access_detail", site_name: Rails.application.config_for(:settings).dig(:site, :name)) %></p>

      <% if monthly_plan %>
        <p class="text-base-content/70 text-sm border-t border-base-content/10 pt-4">
          <%= t(".standard_plan",
                amount: number_to_currency(monthly_plan[:unit_amount].to_f / 100, unit: currency_symbol(monthly_plan[:currency]), strip_insignificant_zeros: true),
                interval: t("organizations.subscriptions.intervals.#{monthly_plan[:interval]}", default: monthly_plan[:interval])) %>
        </p>
      <% end %>
    </div>
  <% end %>
<% elsif subscription %>
  <% labels = subscription_plan_labels(subscription) %>
  <% current_plan = plan_for(subscription) %>
  <% grace_period = subscription.on_grace_period? %>

  <%= render SectionComponent.new(full_width: false) do |component| %>
    <% component.with_page_title t(".title"), back_to: organization_path(Current.organization) %>
    <% unless grace_period %>
      <% component.with_action_list do %>
        <%= button_to labels[:button], organization_subscriptions_billing_portal_path(Current.organization), data: { turbo: false }, class: "btn btn-outline" %>
      <% end %>
    <% end %>

    <div class="rounded-box p-6 space-y-4 <%= grace_period ? "border-2 border-warning/30 bg-warning/5" : "bg-base-200" %>">
      <div>
        <div class="flex items-center gap-2">
          <span class="font-semibold"><%= labels[:status] %></span>
          <%= subscription_status_label(Current.organization) %>
        </div>

        <% if current_plan %>
          <p class="text-3xl font-bold mt-2">
            <%= number_to_currency current_plan[:unit_amount].to_f / 100, unit: currency_symbol(current_plan[:currency]), strip_insignificant_zeros: true %><span class="text-base font-normal text-base-content/70"> / <%= t("organizations.subscriptions.intervals.#{current_plan[:interval]}", default: current_plan[:interval]) %></span>
          </p>
          <p class="text-base-content/70 text-sm mt-1"><%= t(".excluding_tax") %></p>
        <% else %>
          <p class="text-base-content/60 mt-1"><%= subscription.processor_plan %></p>
        <% end %>
      </div>

      <% if grace_period %>
        <div class="rounded-box bg-warning/10 px-4 py-3">
          <p class="text-sm font-medium text-warning"><%= labels[:access] %></p>
        </div>
        <%= button_to labels[:button], organization_subscriptions_billing_portal_path(Current.organization), data: { turbo: false }, class: "btn btn-warning btn-block" %>
      <% else %>
        <div class="border-t border-base-content/10 pt-4">
          <div class="flex items-center justify-between gap-4 text-sm">
            <span class="text-base-content/60"><%= labels[:access] %></span>
            <span class="font-medium"><%= local_time_tag(labels[:date], format: :short) %></span>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
