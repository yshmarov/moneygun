<% content_for :title, t("organizations.edit.title") %>

<%= render SectionComponent.new(title: t("organizations.edit.title")) do |component| %>
  <%= render "form", organization: @organization %>

  <%= render "shared/danger_zone", label: t("shared.danger_zone.label") do %>
    <% if @organization.can_transfer?(current_user) %>
      <li><%= link_to t("organizations.transfers.show.title"), organization_transfer_path(@organization), data: { turbo_frame: :modal } %></li>
    <% end %>
    <% if policy(@organization).destroy? %>
      <li>
        <% if @organization.undeletable_reasons.empty? %>
          <%= link_to t("organizations.edit.delete_organization"), @organization, data: { turbo_method: :delete, turbo_confirm: t("shared.actions.confirm") }, class: "text-error" %>
        <% else %>
          <span class="text-base-content/50"><%= t("organizations.edit.destroy_disabled.has_active_subscription") %></span>
        <% end %>
      </li>
    <% end %>
  <% end %>
<% end %>
