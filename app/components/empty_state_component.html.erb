<div
  class="
    text-center p-10 text-base-content/50 bg-base-200 rounded-2xl border
    border-base-content/5 flex flex-col items-center justify-center gap-6
  "
>
  <%= icon_content %>

  <div>
    <h2 class="text-xl font-semibold text-base-content"><%= title %></h2>

    <% if subtitle.present? %>
      <p class="text-base-content/70 text-base"><%= subtitle %></p>
    <% end %>
  </div>

  <%= content %>
</div>
