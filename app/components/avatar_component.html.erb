<% if @src.present? %>
  <%= image_tag @src, alt: @alt, class: image_classes %>
<% else %>
  <svg class="<%= fallback_classes %>" viewBox="0 0 40 40" role="img" aria-label="<%= @alt %>">
    <text x="20" y="20" text-anchor="middle" dominant-baseline="central" font-size="16" fill="currentColor"><%= @initials %></text>
  </svg>
<% end %>
