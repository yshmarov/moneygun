#!/usr/bin/env bash

set -euo pipefail

WEBSITE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$WEBSITE_ROOT"

hugo --gc --minify --panicOnWarning

for output in public/index.html public/robots.txt public/sitemap.xml; do
  test -s "$output" || { echo "Missing generated file: $output" >&2; exit 1; }
done

rg --quiet '<main id=main>' public/index.html
rg --quiet 'href=https?://[^ >]+/session/new' public/index.html
rg --quiet 'https://github.com/yshmarov/moneygun' public/index.html

echo "Website build checks passed"
