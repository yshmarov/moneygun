# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# Prefer the gitignored .env locally and exported variables in CI.
KAMAL_REGISTRY_PASSWORD=$(.kamal/dotenv KAMAL_REGISTRY_PASSWORD)

# Improve security by using a password manager. Never check config/master.key into git!
RAILS_MASTER_KEY=$(.kamal/dotenv RAILS_MASTER_KEY config/master.key)

# PostgreSQL password for the database accessory
POSTGRES_PASSWORD=$(.kamal/dotenv POSTGRES_PASSWORD)

# S3-compatible Active Storage credentials
AWS_ACCESS_KEY_ID=$(.kamal/dotenv AWS_ACCESS_KEY_ID)
AWS_SECRET_ACCESS_KEY=$(.kamal/dotenv AWS_SECRET_ACCESS_KEY)
S3_ACCESS_KEY_ID=$(.kamal/dotenv AWS_ACCESS_KEY_ID)
S3_SECRET_ACCESS_KEY=$(.kamal/dotenv AWS_SECRET_ACCESS_KEY)

# Database URL constructed from the Postgres accessory running on the same host
DATABASE_URL="postgres://moneygun:${POSTGRES_PASSWORD}@moneygun-db:5432/moneygun_production"
